+            "text": "Account Help"
+        }]
+    }
+  },
+  "designsafe": {
+    "branding": [{
+        "src": "authorize/designsafe.svg",
+        "alt": "DesignSafe"
+    }, {
+        "src": "authorize/tacc.jpg",
+        "alt": "TACC"
+    }],
+    "login": {
+        "register_url": "https://accounts.tacc.utexas.edu/register",
+        "help_links": [{
+            "url": "https://tacc.utexas.edu/about/help/",
+            "text": "Account Help"
+        }]
+    }
+  },
+  "icicle": {
+    "branding": [{
+        "src": "authorize/icicle-logo.png",
+        "alt": "Icicle"
+    }],
+    "login": {
+        "register_url": "https://accounts.tacc.utexas.edu/register",
+        "help_links": [{
+            "url": "https://tacc.utexas.edu/about/help/",
+            "text": "Account Help"
+        }]
+    }
+  },
+  "dev": {
+    "branding": [{
+        "src": "authorize/dev.jpeg",
+        "alt": "Dev"
+    }],
+    "login": {
+        "register_url": "https://accounts.tacc.utexas.edu/register",
